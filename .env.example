# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# Allowed CORS origin for the frontend — REQUIRED in production
CLIENT_ORIGIN=http://localhost:3000

# ── Neon PostgreSQL ───────────────────────────────────────────────────────────
# Use the pooler connection string (not the direct connection)
DATABASE_URL=postgresql://neondb_owner:<password>@<pooler-host>.eu-west-2.aws.neon.tech/neondb?sslmode=require

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Project URL — found in Supabase dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co

# Service role key — found in Supabase dashboard > Settings > API
# Keep this secret — it bypasses Row Level Security
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT secret — found in Supabase dashboard > Settings > API > JWT Settings
# Used for local JWT verification (no network call per request)
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Anthropic AI ──────────────────────────────────────────────────────────────
# API key for claude-sonnet-4-6 (used for AI narrative generation)
ANTHROPIC_API_KEY=sk-ant-...
